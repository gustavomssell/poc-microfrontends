# Entries dos remotes consumidos pelo shell.
# Default (sem variável): http://localhost:<porta>/remoteEntry.js
#
# Em produção aponte para os builds publicados, por exemplo:
# VITE_CATALOG_ENTRY=https://cdn.exemplo.com/catalog/v1.4.0/remoteEntry.js
VITE_CATALOG_ENTRY=http://localhost:5001/remoteEntry.js
VITE_CART_ENTRY=http://localhost:5002/remoteEntry.js
VITE_CHECKOUT_ENTRY=http://localhost:5003/remoteEntry.js
